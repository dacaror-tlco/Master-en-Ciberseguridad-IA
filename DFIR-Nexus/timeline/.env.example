# Copia este archivo a .env y rellena con tus valores reales.
# Base de datos compartida (development): mismo motor que Casos/OSINT/
# Tracking, pero Timeline solo gestiona su propia tabla (timeline_events).
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE

# Identidad (Fase 4): mismo JWT_SECRET que emite el backend de Casos —
# este backend solo lo usa para VERIFICAR los JWT que le llegan, nunca
# emite ninguno. Debe ser idéntico al JWT_SECRET de backend/.env.
JWT_SECRET=change-me-in-real-deployment
