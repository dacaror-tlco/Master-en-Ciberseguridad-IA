# Copia este archivo a .env y rellena los valores.

# Base de datos. El motor oficial del proyecto es MySQL (ver CLAUDE.md);
# para desarrollo local sin servidor, vale SQLite:
#   DATABASE_URL=sqlite:///./nexus_dev.db
DATABASE_URL=

# Solo si se usa MySQL en contenedor (ver deploy/docker-compose.yml)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=

# Carpeta de la cadena de integridad local (opcional). Por defecto,
# .tracking_chain/ en la raiz del modulo, sea cual sea el directorio de arranque.
# TRACKING_CHAIN_DIR=

# Identidad (Fase 4 de development): MISMO secreto que el backend de Casos,
# que es el unico que emite tokens; aqui solo se verifican. Si no coincide,
# todas las peticiones responden 401.
JWT_SECRET=change_me

# Solo para arrancar este modulo SUELTO, sin el frontend de development (no
# hay pantalla de login de la que sacar un token). Con cualquier otro valor,
# o sin la variable, la autenticacion es obligatoria.
# TRACKING_AUTH_DESACTIVADA=1
