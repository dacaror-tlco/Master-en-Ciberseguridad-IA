{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set DATABASE_URL=sqlite:///./nexus_dev.db && venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8000"
      ],
      "port": 8000,
      "url": "http://localhost:8000"
    },
    {
      "name": "frontend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd frontend && npm run dev"],
      "port": 5173,
      "url": "http://localhost:5173"
    }
  ]
}
