# Copia este archivo a .env y rellena los valores.

# Base de datos. El motor oficial del proyecto es MySQL (ver CLAUDE.md);
# para desarrollo local sin servidor, vale SQLite:
#   DATABASE_URL=sqlite:///./nexus_dev.db
DATABASE_URL=

# Solo si se usa MySQL en contenedor (ver deploy/docker-compose.yml)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=
