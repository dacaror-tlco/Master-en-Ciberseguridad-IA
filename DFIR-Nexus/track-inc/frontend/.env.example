# Solo para el modo desarrollo (Vite en :5173, backend en :8000). El build
# de produccion llama al mismo origen (ver .env.production).
#
# VITE_API_BASE_URL: la usa el modulo de casos de prueba de este repositorio.
# VITE_TRACKING_API_URL: la de Tracking (el mismo nombre que en el frontend
# unico de development). En local se usa "localhost", nunca "127.0.0.1",
# como en development.
VITE_API_BASE_URL=http://localhost:8000
VITE_TRACKING_API_URL=http://localhost:8000
