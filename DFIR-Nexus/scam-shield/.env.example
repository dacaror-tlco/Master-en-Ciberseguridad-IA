# Copia este archivo a .env y rellena con tus claves
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
ETHERSCAN_API_KEY=
# Tron/TRC20: opcional, funciona sin key (límite de rate más bajo). Gratis en https://www.trongrid.io
TRON_API_KEY=
ANTHROPIC_API_KEY=
OPENSPAM_API_KEY=
SERPAPI_API_KEY=
PIMEYES_API_KEY=
IPQUALITYSCORE_API_KEY=
# FCA Register (Reino Unido) — registro gratuito en https://register.fca.org.uk/Developer/s/
FCA_API_EMAIL=
FCA_API_KEY=
# Twilio Lookup (line_type_intelligence): única integración de pago, sin
# tier gratuito. Vacío = esa señal simplemente no se pide.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# URL pública de esta instancia (sin barra final), necesaria solo para que
# SerpApi pueda descargar la imagen a analizar. Vacío = búsqueda inversa
# degrada a los enlaces manuales (Google Images/TinEye/Yandex).
PUBLIC_BASE_URL=
# Base de datos MySQL (mismo patrón que el resto de módulos de Nexus).
# Para pruebas se puede apuntar directo a la BD compartida de Nexus en Aiven
# (host/puerto que te pasen); pymysql negocia TLS solo, sin config extra.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=scamshield_user
MYSQL_PASSWORD=change_me
MYSQL_DB=scamshield

# Alternativa a MySQL para desarrollo 100% local y offline: descomenta y se
# usa tal cual, ignorando las MYSQL_* de arriba.
# DB_URL=sqlite:///./scamshield_local.db

# Backend de Casos (Módulo 1) — solo para comprobar que un caso existe al
# vincular una investigación OSINT y para dejar constancia del cambio en
# su auditoría (ver app/modules/osint/case_link/). Valor por defecto ya
# correcto para desarrollo local con el lanzador del proyecto.
CASES_API_BASE_URL=http://localhost:8000

# Identidad (Fase 4): mismo JWT_SECRET que emite el backend de Casos — este
# backend solo lo usa para VERIFICAR los JWT que le llegan, nunca emite
# ninguno. Debe ser idéntico al JWT_SECRET de backend/.env.
JWT_SECRET=change_me

# Secreto de servicio exclusivo de POST /cases/{id}/auditoria/osint —
# distinto de JWT_SECRET. Debe ser idéntico al OSINT_AUDIT_SERVICE_TOKEN de
# backend/.env; no lo comparte ningún otro backend ni el frontend.
OSINT_AUDIT_SERVICE_TOKEN=change_me
