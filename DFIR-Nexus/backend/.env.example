# Copia este archivo a .env y rellena con tus valores reales.
# NUNCA subas .env ni credenciales reales a ningún commit ni rama.
#
# Base de datos compartida (development): los 5 backends de Nexus apuntan
# a la misma instancia MySQL, pero cada uno gestiona únicamente sus propias
# tablas (ver docs/CONTRATOS.md). Estos valores son los de Casos.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=nexus_user
MYSQL_PASSWORD=change_me
MYSQL_DB=nexus

# Identidad: secreto para firmar/verificar JWT (HS256). Debe ser una
# cadena aleatoria larga en cualquier entorno real, y la MISMA en los 5
# backends (se comparte vía .env, igual que las credenciales de MySQL) a
# partir de la Fase 4. Genera una con, por ejemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me
JWT_EXPIRE_MINUTES=120

# Fase 4: secreto de servicio exclusivo de POST /cases/{id}/auditoria/osint
# — distinto de JWT_SECRET. Compartido ÚNICAMENTE con scam-shield/.env
# (OSINT_AUDIT_SERVICE_TOKEN ahí), nunca con el frontend ni con los demás
# backends. Genera uno con el mismo comando de arriba.
OSINT_AUDIT_SERVICE_TOKEN=change_me

# Solo para scripts/bootstrap_admin.py (crear el primer usuario admin).
# Opcional: si no se definen, el script los pide de forma interactiva.
# ADMIN_EMAIL=admin@nexus.local
# ADMIN_PASSWORD=
