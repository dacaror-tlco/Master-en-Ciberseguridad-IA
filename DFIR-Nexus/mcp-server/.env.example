# Copia este archivo a .env y rellena con tus valores reales.
# NUNCA subas .env ni credenciales reales a ningún commit ni rama.
#
# Backends que este MCP Server consume hoy: los 5 de Nexus.
CASOS_BASE_URL=http://localhost:8000
TIMELINE_BASE_URL=http://localhost:8002
INFORMES_BASE_URL=http://localhost:8003
TRACKING_BASE_URL=http://localhost:8001
OSINT_BASE_URL=http://localhost:8124

# Credenciales del USUARIO DE SERVICIO con el que este MCP Server se
# autentica contra POST /auth/login. NO es la cuenta de ningún analista
# humano: créala aparte (p. ej. con backend/scripts/bootstrap_admin.py, o
# un alta normal vía POST /auth/users una vez exista un admin) con el rol
# mínimo necesario (analyst basta para GET /cases/{id}).
MCP_SERVICE_EMAIL=mcp-server@nexus.local
MCP_SERVICE_PASSWORD=change_me

# Alternativa a las dos de arriba: un JWT ya emitido por Casos. Con él, el
# proceso nunca inicia sesión y actúa con la identidad de ese token. No se
# rellena a mano: es como lo lanza el asistente de Informes, con el token del
# analista que pregunta (ver sharingan/app/modules/chat/fuente_mcp.py).
MCP_ACCESS_TOKEN=

# Fase 2I: directorios LOCALES desde los que `analizar_log` puede leer un
# fichero, separados por coma (rutas absolutas). VACÍO por defecto: sin
# configurar al menos uno, la tool rechaza cualquier ruta. Cada ruta que
# se pida se resuelve con Path.resolve() (sigue symlinks) y se comprueba
# que el resultado queda DENTRO de uno de estos directorios — nunca se
# acepta nada fuera de esta lista, tampoco vía path traversal o symlink.
# Ejemplo, apuntando al directorio de pruebas ya incluido en este repo:
MCP_ALLOWED_FILE_DIRS=/home/mylopez/DFIR-Nexus/mcp-server/lab_files
