# Copia a deploy/.env (o súbelo tal cual en el formulario de Portainer,
# ambas formas funcionan igual) y rellena con los valores reales.
# NUNCA subas este archivo con claves reales a ningún commit.

# Base de datos: la misma instancia MySQL compartida de Aiven que ya usa
# el equipo en desarrollo (ver docs/INTEGRACION_Y_DESPLIEGUE.md) — no se
# levanta MySQL en este stack, todos los backends apuntan aquí.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=

# URL pública final de esta instancia (sin barra final) — la usa OSINT
# para construir PUBLIC_BASE_URL (ver docker-compose.yml) y así SerpApi
# pueda descargar la imagen a analizar en la búsqueda inversa.
PUBLIC_URL=https://nexus.gondorhub.com

# --- Identidad (Fase 4) ---
# Secreto con el que Casos FIRMA los JWT y los otros cuatro backends los
# VERIFICAN: el mismo valor para los cinco, o las sesiones no valdrán fuera
# del módulo que las creó. Si se deja vacío, el compose cae al valor por
# defecto del código ("change_me") — que es lo que hay hoy en el stack
# publicado, así que dejarlo vacío NO rompe nada, solo no arregla nada.
#
# Rellenarlo (32+ bytes aleatorios: `openssl rand -hex 32`) es lo correcto y
# su único efecto visible es que todo el mundo vuelva a iniciar sesión: las
# contraseñas viven hasheadas en la tabla `users` y no se tocan.
JWT_SECRET=
# Vida del token, en minutos. Vacío = 120.
JWT_EXPIRE_MINUTES=
# Secreto DISTINTO del anterior, solo entre Casos y OSINT: autentica la
# llamada servidor->servidor que registra en la auditoría del caso lo que
# hace OSINT. Nunca llega al frontend.
OSINT_AUDIT_SERVICE_TOKEN=

# --- Asistente conversacional (sharingan, POST /chat) ---
# Motor del asistente y de la narrativa del informe. En este stack la única
# opción viable es "anthropic" (no hay Ollama en los contenedores, y en el Pi
# no sería usable). Vacíos = "anthropic", que es lo que se quiere.
CHAT_PROVIDER=
# mcp (por defecto) o sql: de dónde lee el asistente el expediente.
CHAT_CONTEXTO=
NARRATIVA_PROVIDER=
ANTHROPIC_CHAT_MODEL=

# --- OSINT y Fraude (scam-shield) ---
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
ETHERSCAN_API_KEY=
TRON_API_KEY=
OPENSPAM_API_KEY=
SERPAPI_API_KEY=
PIMEYES_API_KEY=
IPQUALITYSCORE_API_KEY=
FCA_API_EMAIL=
FCA_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Informes (sharingan) ---
# Obligatoria para completar la generación de informes (ver
# docs/INTEGRACION_Y_DESPLIEGUE.md §14) — sin ella, POST /reports/generate
# responde 503 controlado. También la usa OSINT (opcional, narrativa IA
# de email), así que una sola key cubre ambos usos.
ANTHROPIC_API_KEY=
