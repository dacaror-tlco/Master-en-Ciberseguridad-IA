# Copia este archivo a .env y rellena con tus valores
DATABASE_URL=mysql+pymysql://usuario:contraseña@localhost:3306/nexus_informes
ANTHROPIC_API_KEY=
# Carpeta donde se guardan los PDF generados (se crea si no existe)
REPORTS_STORAGE_DIR=./storage/reports

# --- Asistente conversacional (app/modules/chat) -----------------------
# Quién responde en el chat: "anthropic" (por defecto, y lo que usa el equipo)
# u "ollama" (modelo local). La vía local está entera y probada, pero sin GPU
# tarda del orden de cinco minutos por respuesta, así que no se usa.
#
# Con "anthropic", el expediente que entra en el prompt —evidencias, usuarios,
# IPs, rutas— se envía a un tercero. Es una decisión consciente, no un
# descuido: si un caso no puede salir de la máquina, se pone "ollama" aquí y
# no hay que cambiar nada más.
CHAT_PROVIDER=anthropic
# De dónde lee el asistente el expediente: «mcp» (por defecto), a través del
# servidor MCP de ../mcp-server y con el JWT de quien pregunta, o «sql»,
# directamente de la base. Con «mcp», este venv necesita también las
# dependencias de mcp-server (ya están en requirements.txt).
CHAT_CONTEXTO=mcp
# Las tres siguientes solo se usan con CHAT_PROVIDER=ollama.
#
# ATENCION: ningun modelo local de los probados sostiene las reglas del prompt
# frente a una inyeccion incrustada en una evidencia. Medido el 26/09/2026:
# qwen2.5:1.5b-instruct resistio 3 de 7 ataques y qwen2.5:3b-instruct falla la
# anulacion directa de instrucciones en 2 de cada 4 pasadas. Lo que aguanta en
# los dos es el codigo (aislamiento entre casos y verificacion de citas). Ver el
# apartado Seguridad del README antes de elegir esta via para un caso real.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
# Ventana de contexto del modelo local. Si se queda corta, Ollama descarta el
# principio del prompt, que es donde van las reglas de citación y de alcance.
OLLAMA_NUM_CTX=8192
# Un modelo local sin GPU tarda decenas de segundos por respuesta.
CHAT_TIMEOUT_SECONDS=600
# El modelo que responde con CHAT_PROVIDER=anthropic.
ANTHROPIC_CHAT_MODEL=claude-opus-5

# Quién redacta los hallazgos y las conclusiones del INFORME: "anthropic"
# (por defecto) u "ollama" (modelo local, sin API de pago). Se decide aparte
# del chat a propósito: una respuesta de chat floja se descarta releyéndola,
# pero el informe se firma y se entrega. Sea cual sea, el apartado 8 del
# informe declara el modelo concreto que lo redactó.
NARRATIVA_PROVIDER=anthropic
# Tope de generación de la narrativa en local. 1200 ~ 600 palabras ~ 4-5 min
# sin GPU. Con GPU se puede subir.
OLLAMA_NARRATIVA_NUM_PREDICT=1200
# Cuánto mantiene Ollama el modelo en memoria tras responder. El defecto de
# Ollama (5 min) hace que una pausa para leer la respuesta ya baste para que
# lo descargue, y la siguiente pregunta paga otra vez la carga de 2,4 GB.
OLLAMA_KEEP_ALIVE=30m

# Identidad (Fase 4): mismo JWT_SECRET que emite el backend de Casos — este
# backend solo lo usa para VERIFICAR los JWT que le llegan, nunca emite
# ninguno. Debe ser idéntico al JWT_SECRET de backend/.env.
JWT_SECRET=change_me
