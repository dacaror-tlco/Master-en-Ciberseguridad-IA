# Convención del proyecto (ver docs/INTEGRACION_Y_DESPLIEGUE.md): en local
# todo se referencia por "localhost", nunca por "127.0.0.1". No es solo
# estética — Casos (backend/app/main.py) solo permite en su CORS el origen
# exacto "http://localhost:5173", así que este frontend SIEMPRE debe abrirse
# como localhost:5173 (127.0.0.1:5173 es, para CORS, un origen distinto y
# sería rechazado). Las variables de abajo no son el origen del navegador,
# pero se mantienen en "localhost" por coherencia y para evitar confusiones.
VITE_API_BASE_URL=http://localhost:8000

# URL del backend independiente de Tracking (track-inc), consumido desde
# /tracking dentro de este mismo frontend (a diferencia de OSINT, la UI de
# Tracking sí vive integrada aquí — solo su backend es un proceso aparte).
VITE_TRACKING_API_URL=http://localhost:8001

# URL del backend independiente de Timeline, consumido desde /timeline
# dentro de este mismo frontend (misma lógica que Tracking: la UI vive
# aquí, solo su backend es un proceso aparte).
VITE_TIMELINE_API_URL=http://localhost:8002

# URL del backend independiente de Informes (sharingan), consumido desde
# /reports dentro de este mismo frontend (misma lógica que Tracking y
# Timeline: la UI vive aquí, solo su backend es un proceso aparte).
VITE_REPORTS_API_URL=http://localhost:8003

# URL del backend independiente de OSINT y Fraude (scam-shield), consumido
# desde /osint dentro de este mismo frontend — misma lógica que Tracking,
# Timeline e Informes. Sustituye al antiguo VITE_OSINT_APP_URL (que apuntaba
# a un segundo frontend en :5174, hoy ya integrado aquí; ver "Arquitectura
# frontend" en docs/INTEGRACION_Y_DESPLIEGUE.md).
VITE_OSINT_API_URL=http://localhost:8124
